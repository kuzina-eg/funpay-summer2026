---
<Layout title="Lootery">

    <FinishPromo
        title="The raffle has concluded"
        titleWinner="The <span class='u-text-accent'>Loot</span>ery has concluded"
        text="We&rsquo;ve announced the winners on our Twitch stream"
        buttonText="Watch the broadcast on Twitch"
        isWinner={false}
        boxTitle="Sorry, no prizes<br> for now"
        boxTitleWinner="Congrats! You won:<br> Nintendo Switch 2"
        boxText="Better luck next time! Keep your head up and stay tuned for future announcements"
        boxTextWinner="Wow, talk about luck! We&rsquo;ll reach out to you via DMs on FunPay to sort out the delivery. Hope your winning streak keeps on going"
        myTicketsBoxTitle1="Winning ticket:"
    ></FinishPromo>

    <div class="container">
        <Winners
            title="Winners"
            items={prizes}
            winnerName="Winner"
            ticket="Ticket"
            modalText="This prize has been successfully Looted:"
            buttonText="Check my tickets"
            allTickets="All tickets"
            ticketItems={myTickets}
            myTicketsBoxTitle1="You have"
            myTicketsBoxTitle2="37 tickets"
            tableParamName="Order"
            tableValueName="Tickets"
        ></Winners>
    </div>
</Layout>
