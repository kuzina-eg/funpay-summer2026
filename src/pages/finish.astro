<Layout title="Лутерея">

    <FinishPromo
        title="Конкурс завершен"
        titleWinner="<span class='u-text-accent'>Лут</span>ерея завершена"
        text="Итоги розыгрыша мы&nbsp;подвели на&nbsp;стриме"
        buttonText="Смотреть итоги на Twitch"
        isWinner={false}
        boxTitle="Увы, в этот<br> раз без призов"
        boxTitleWinner="Поздравляем! Вы выиграли:<br> Nintendo Switch 2"
        boxText="В&nbsp;следующий раз вам обязательно повезёт! Не&nbsp;теряйте надежду и&nbsp;следите за&nbsp;анонсами"
        boxTextWinner="Воу, вот это удача! Мы&nbsp;свяжемся с&nbsp;вами&nbsp;в&nbsp;личных сообщениях на&nbsp;FunPay, чтобы обсудить доставку приза. Пусть&nbsp;вам везёт и&nbsp;дальше"
        myTicketsBoxTitle1="Выиграл билет:"
    ></FinishPromo>

    <div class="container">
        <Winners
            title="Победители"
            items={prizes}
            winnerName="Победитель"
            ticket="Билет"
            modalText="Этот приз успешно залутали:"
            buttonText="Посмотреть мои билеты"
            allTickets="Все билеты"
            ticketItems={myTickets}
            myTicketsBoxTitle1="У вас"
            myTicketsBoxTitle2="37 билетиков"
            tableParamName="Заказ"
            tableValueName="Билеты"
        ></Winners>
    </div>
</Layout>
