<Layout title="Лутерея">

    <FinishPromo
        noteText="Дякуємо за участь!"
        titleWinner="<span class='u-text-accent'>Лут</span>ерею завершено"
        text="Підсумки розіграшу ми&nbsp;підбили на&nbsp;стрімі"
        buttonText="Подивитися підсумки на Twitch"
        isWinner={true}
        boxTitle="На жаль, цього<br> разу без призів"
        boxTitleWinner="Вітаємо! Ви виграли:<br> Nintendo Switch 2"
        boxText="Наступного разу вам обов&rsquo;язково пощастить! Не&nbsp;втрачайте надії, слідкуйте за&nbsp;анонсами"
        boxTextWinner="Воу! Оце так пощастило! Ми&nbsp;зв&rsquo;яжемося з&nbsp;вами в&nbsp;особистих повідомленнях на&nbsp;FunPay, щоб обговорити доставку призу. Нехай щастить і&nbsp;надалі"
        myTicketsBoxTitle1="Виграв білет:"
    ></FinishPromo>

    <div class="container">
        <Winners
            title="Переможці"
            items={prizes}
            winnerName="Переможець"
            ticket="Білет"
            modalText="Цей приз успішно залутали:"
            buttonText="Переглянути мої білети"
            allTickets="Усі білети"
            ticketItems={myTickets}
            myTicketsBoxTitle1="У вас"
            myTicketsBoxTitle2="37 білетів"
            tableParamName="Замовлення"
            tableValueName="Білети"
        ></Winners>
    </div>
</Layout>
