    },
    {
        title: 'Я&nbsp;выиграл. Кому написать, чтобы получить приз?',
        text: 'Поздравляем. Если вы&nbsp;выиграли, с&nbsp;вами свяжется в&nbsp;личных сообщениях на&nbsp;FunPay сотрудник с&nbsp;плашкой &laquo;Поддержка&raquo;, чтобы обсудить доставку приза. Самостоятельно никому писать не&nbsp;нужно.',
    },
    {
        title: 'Мой заказ отменили. Билеты за&nbsp;него останутся у&nbsp;меня?',
        text: 'Нет, билеты, полученные за&nbsp;обнуленный заказ, отзовут. Они не&nbsp;будут участвовать в&nbsp;розыгрыше.',
    },
]

---
<Layout title="Лутерея">

    <Promo
        statisticTextStart="Всего"
        statisticTextLink="билетов"
        statisticTextLast="в розыгрыше:"
        statisticValue="135&nbsp;658&nbsp;224"
        title="РОБУКС ФЕСТ"
        text="Покупайте и продавайте в разделе Роблокс с 1 по 31 июля и участвуйте в розыгрыше призов"
        buttonText="Участвовать"
        buttonTextLogin="Мои билеты"
        countdownTitle="До конца осталось:"
        countdownDays="дней"
        countdownHours="часов"
        countdownMinutes="минут"
        isLogin={true}
    ></Promo>


    <div class="container">
        <Prizes
            items={prizes}
            modalText="Хотите бустануть свои шансы?<br> Покупайте на FunPay"
            buttonText="За покупками"
        ></Prizes>

        <DonatedPcs
            title="Уже подаренные ПК"
        ></DonatedPcs>

        <MyTickets
            title="Мои билеты"
            myTicketsText1="Каждые"
            myTicketsText2="100 рублей"
            myTicketsText3="в разделе Роблокс на FunPay приносят"
            myTicketsText4="1 билет."
            note="Чем больше билетов собрано, тем выше шанс залутать ценные призы."
            myTicketsBoxTitle1="У вас"
            myTicketsBoxTitle2="37 билетиков"
            myTicketsBoxText="<p>Всего участников: <span class='ticket-participants'>235&nbsp;6589</span></p><p>Среднее число билетов на участника: <span class='ticket-average'>15</span></p>"
            buttonText="Посмотреть мои билеты"
            items={myTickets}
            tableParamName="Заказ"
            tableValueName="Билеты"
        ></MyTickets>

        <Instructions
            title="Как участвовать?"
            items={instructions}
            note="Важно: в&nbsp;розыгрыше учитываются только продажи и&nbsp;покупки, совершённые с&nbsp;1&nbsp;по&nbsp;31&nbsp;июля в&nbsp;разделе Роблокс."
        ></Instructions>

        <Faq
            title="Остались вопросы?"
            items={faq}
        ></Faq>
    </div>
</Layout>
