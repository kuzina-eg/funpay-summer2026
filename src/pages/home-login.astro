const instructions = [
    {
        num: '1',
        title: 'Покупайте<br> и продавайте<br> на FunPay',
        text: 'Присоединитесь к&nbsp;розыгрышу, нажав кнопку &laquo;Участвовать&raquo;. Купите или продайте любую услугу или товар на&nbsp;сумму от&nbsp;100&nbsp;₽ и&nbsp;получите первый билет. Всего можно собрать до&nbsp;100&nbsp;билетов.',
