const instructions = [
    {
        num: '1',
        title: 'Покупайте<br> или продавайте на FunPay в&nbsp;разделе Роблокс',
        text: 'Присоединитесь к&nbsp;розыгрышу, нажав кнопку &laquo;Участвовать&raquo;. Купите или продайте любую услугу или товар на&nbsp;сумму от&nbsp;100&nbsp;₽ в&nbsp;разделе Роблокс и&nbsp;получите первый билет. Всего можно собрать до&nbsp;100&nbsp;билетов.',
