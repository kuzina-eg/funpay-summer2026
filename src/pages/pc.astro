            { x: '25.1%', y: '64.5%', label: 'Корпус:', text: 'для фаната Path of Exile', place: 'tl' },
            { x: '24.8%', y: '87.8%', label: 'Стол:', text: '<br>HYPERPC MAX', place: 'tl' },
            { x: '53.5%', y: '85.7%', label: 'Клавиатура:', text: '<br>HYPERPC KEYBOARD', place: 'br' },
            { x: '90.1%', y: '84.9%', label: 'Мышка:', text: 'Razer<br>Viper V3 Pro', place: 'tl' },
        ],
    },
    {
        image: 'setup-2',
