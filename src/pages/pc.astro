            { x: '65.3%', y: '64.9%', label: 'Мышка:', text: 'WLMOUSE<br>Beast X Max', place: 'tl' },
            { x: '42.4%', y: '78.4%', label: 'Клавиатура:', text: 'Wobkey<br>Crush 80 Reboot Pro', place: 'br' },
            { x: '26.5%', y: '89.3%', label: 'Стол:', text: '<br>HYPERPC MAX', place: 'tl' },
        ],
    },
    {
        image: 'setup-3',
        alt: 'Сетап с креслом, микрофоном и коллекционным изданием World of Warcraft',
        points: [
            { x: '84.2%', y: '21.1%', label: 'Корпус:', text: 'для фанатки<br>World of Warcraft', place: 'tl' },
            { x: '14.8%', y: '29.3%', label: 'Микрофон:', text: 'HyperX<br>QuadCast 2S', place: 'br' },
            { x: '50.1%', y: '50.5%', label: 'Наушники:', text: 'Razer<br>BlackShark V3 Pro', place: 'br' },
            { x: '4.7%',  y: '64.2%', label: 'Кресло:', text: 'Herman Miller<br>Cosm High Glacier', place: 'br' },
            { x: '29.7%', y: '65.7%', label: 'Коллекционка', text: '<br>World of Warcraft Midnight', place: 'br' },
        ],
    },
    {
        image: 'setup-4',
        alt: 'Рабочее место победителя Лутереи: два монитора, колонки и комп в корпусе Roblox',
        points: [
            { x: '93.2%', y: '19.9%', label: 'Корпус:', text: 'для фаната<br>Roblox', place: 'tl' },
            { x: '46.1%', y: '28.6%', label: 'Монитор:', text: 'ASUS ROG Swift<br>OLED PG27UCDM,&nbsp; 4K/240Гц', place: 'tl' },
