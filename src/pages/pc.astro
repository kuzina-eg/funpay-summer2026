            { x: '39.3%', y: '13.1%', label: 'Микрофон:', text: 'HyperX<br>QuadCast 2S', place: 'tl' },
            { x: '52.6%', y: '49.8%', label: 'VR:', text: '<br>Meta Quest 3', place: 'tl' },
            { x: '69.3%', y: '51.2%', label: 'Наушники:', text: 'Audeze Maxwell 2', place: 'br' },
        ],
