    },
]

---
<Layout title="Лутерея">

    <Promo
        statisticTextStart="Усього"
        statisticTextLink="білетів"
        statisticTextLast="у розіграші:"
        statisticValue="135&nbsp;658&nbsp;224"
        title="<span class='u-text-accent'>Лут</span>ерея"
        text="Купуйте та&nbsp;продавайте на&nbsp;FunPay з&nbsp;15&nbsp;серпня по&nbsp;15&nbsp;вересня та&nbsp;беріть участь у&nbsp;розіграші геймерського луту"
        buttonText="Взяти участь"
        buttonTextLogin="Мої білети"
        countdownTitle="До кінця залишилося:"
        countdownDays="днів"
        countdownHours="годин"
        countdownMinutes="хвилин"
    ></Promo>


    <div class="container">
        <Prizes
            items={prizes}
            modalText="Подобається приз? Бустаніть шанси<br> його виграти."
            buttonText="За покупками"
        ></Prizes>

        <DonatedPcs
            title="Попередні компи мрії"
        ></DonatedPcs>

        <MyTickets
            title="Мої білети"
            myTicketsText1="Кожне"
            myTicketsText2="1 євро"
            myTicketsText3="на FunPay приносить"
            myTicketsText4="1 білет."
            note="Чим більше білетів зібрано, тим вищий шанс отримати цінні призи."
            myTicketsBoxTitle1="У вас"
            myTicketsBoxTitle2="37 білетів"
            myTicketsBoxText="<p>Усього учасників: <span class='ticket-participants'>2&nbsp;356&nbsp;589</span></p><p>Середня кількість білетів на учасника: <span class='ticket-average'>15</span></p>"
            buttonText="Переглянути мої білети"
            items={myTickets}
            tableParamName="Замовлення"
            tableValueName="Білети"
        ></MyTickets>

        <Instructions
            title="Як взяти участь?"
            items={instructions}
            note="Важливо: у&nbsp;розіграші враховуються лише продажі та&nbsp;покупки, здійснені з&nbsp;15&nbsp;серпня по&nbsp;15&nbsp;вересня.<br> Купуйте, продавайте на&nbsp;FunPay та&nbsp;лутайтесь!"
        ></Instructions>

        <Faq
            title="Залишилися питання?"
            items={faq}
        ></Faq>
    </div>
</Layout>
