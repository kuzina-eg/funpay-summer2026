---
<Layout title="Lootery">

    <Promo
        statisticTextStart="Total"
        statisticTextLink="tickets"
        statisticTextLast="in the raffle:"
        statisticValue="135&nbsp;658&nbsp;224"
        title="<span class='u-text-accent'>Loot</span>ery"
        text="Buy and sell on FunPay between August&nbsp;15th and September&nbsp;15th and join the raffle for a chance to win gamer loot"
        buttonText="Join"
        buttonTextLogin="My tickets"
        countdownTitle="Expires in:"
        countdownDays="days"
        countdownHours="hours"
        countdownMinutes="minutes"
    ></Promo>


    <div class="container">
        <Prizes
            items={prizes}
            modalText="Noticed a prize you really like?<br> Boost your chances to win."
            buttonText="Go Shopping"
        ></Prizes>

        <DonatedPcs
            title="Previous versions of God-tier PCs"
        ></DonatedPcs>

        <MyTickets
            title="My tickets"
            myTicketsText1="Every"
            myTicketsText2="1 &euro;"
            myTicketsText3="spent on FunPay earns you"
            myTicketsText4="1 ticket."
            note="The more tickets you collect, the higher your chances of looting valuable prizes."
            myTicketsBoxTitle1="You have"
            myTicketsBoxTitle2="37 tickets"
            myTicketsBoxText="<p>Total participants: <span class='ticket-participants'>235&nbsp;6589</span></p><p>Average tickets per participant: <span class='ticket-average'>15</span></p>"
            buttonText="Check my tickets"
            items={myTickets}
            tableParamName="Order"
            tableValueName="Tickets"
        ></MyTickets>

        <Instructions
            title="How do I participate?"
            items={instructions}
            note="Important: only sales and purchases made between August&nbsp;15th and September&nbsp;15th are eligible for the raffle.<br> Trade on FunPay and grab your loot!"
        ></Instructions>

        <Faq
            title="Still have questions?"
            items={faq}
        ></Faq>
    </div>
</Layout>
